{
  "expo": {
    "name": "KhelGujarat GIS",
    "slug": "khelgujarat-gis",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/Logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/sports.png",
      "resizeMode": "contain",
      "backgroundColor": "#007D40"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow KhelGujarat to scan attendance QR passes and capture infrastructure condition audits."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow KhelGujarat to upload infrastructure audit photos and grant milestone proofs."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow KhelGujarat to show nearby sports complexes and calculate travel distance."
        }
      ]
    ],
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "gov.gujarat.khelgujarat"
    },
    "android": {
      "package": "gov.gujarat.khelgujarat",
      "adaptiveIcon": {
        "foregroundImage": "./assets/Logo.png",
        "backgroundColor": "#007D40"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
